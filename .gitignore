# Ignore temporary files
temp
*.tmp
*.temp

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments
venv/
.venv/
env/

# Ignore log files and databases
*.log
*.sqlite3

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore specific output directories
output/
build/
dist/

# Ignore system files
.DS_Store
Thumbs.db
*.bak
*.swp
*.swo

cache/

.vercel

# Generated outputs and runtime dirs.
# Sample inputs under data/ are intentionally tracked.
downloads/
uploads/

# Local editor and tooling directories. Not part of the project; they stay on
# the machine that created them.
.agents/
.codex/
.claude/
skills-lock.json
.impeccable/

# Runtime job store and result blobs.
jobs.sqlite*
results/
